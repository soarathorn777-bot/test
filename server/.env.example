# Postgres (docker compose maps the container's 5432 to host 5433)
DATABASE_URL="postgresql://app:app@localhost:5433/app?schema=public"

NODE_ENV=development
PORT=4000

# Comma-separated list of allowed browser origins
CORS_ORIGIN="http://localhost:5173"

# CHANGE THESE. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="dev-access-secret-change-me-in-production-0123456789"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-in-production-0123456789"

ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
